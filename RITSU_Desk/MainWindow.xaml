<Window x:Class="RITSU_Desk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:RITSU_Desk.Controls"
        Title="RITSU Desk"
        Width="1360" Height="860" MinWidth="1024" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource Font.Text}"
        Background="{DynamicResource App.Background}"
        Foreground="{DynamicResource Text.Primary}"
        UseLayoutRounding="True">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding Dialogs.Current.CancelCommand}" />
    </Window.InputBindings>

    <Grid>
        <ContentControl Content="{Binding Current}" Focusable="False" />

        <Grid Visibility="{Binding Dialogs.Current, Converter={StaticResource Visible}}">
            <Border Background="{DynamicResource Overlay.Backdrop}" />
            <Border Style="{StaticResource Card}" Padding="28,24" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Effect="{StaticResource Shadow.Popup}" KeyboardNavigation.TabNavigation="Cycle">
                <ContentControl Content="{Binding Dialogs.Current}" Focusable="False" />
            </Border>
        </Grid>

        <ItemsControl ItemsSource="{Binding Notifications.Toasts}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                      Margin="0,0,24,24" Width="380" Focusable="False" AutomationProperties.LiveSetting="Polite">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource Toast.Background}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1"
                            CornerRadius="12" Padding="14,12" Margin="0,10,0,0" Effect="{StaticResource Shadow.Popup}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <c:IconChip Glyph="{Binding Glyph}" Kind="{Binding BadgeKind}" Width="30" Height="30" VerticalAlignment="Top" />
                            <StackPanel Grid.Column="1" Margin="12,0,6,0">
                                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Base}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Body}" Foreground="{DynamicResource Text.Secondary}"
                                           FontSize="12.5" Margin="0,2,0,0" />
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource Button.Icon}" Width="28" Height="28" MinHeight="0" FontSize="10"
                                    Content="&#xE711;" Command="{Binding CloseCommand}" VerticalAlignment="Top"
                                    ToolTip="Tutup" AutomationProperties.Name="Tutup notifikasi" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
