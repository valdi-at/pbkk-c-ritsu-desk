<UserControl x:Class="RITSU_Desk.Controls.StatCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Border Style="{StaticResource Card}" Padding="18,16">
        <StackPanel>
            <TextBlock Text="{Binding Title, ElementName=Root, Converter={StaticResource Upper}}" Style="{StaticResource Text.Overline}"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Title, ElementName=Root}" />
            <Border x:Name="Chip" Height="48" CornerRadius="{StaticResource Radius.Chip}" Margin="0,10,0,8" Padding="12,0">
                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Height="28" HorizontalAlignment="Center">
                    <TextBlock x:Name="ValueText" Text="{Binding Value, ElementName=Root}" FontFamily="{StaticResource Font.Display}"
                               FontSize="20" FontWeight="Bold" />
                </Viewbox>
            </Border>
            <TextBlock Text="{Binding Caption, ElementName=Root}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</UserControl>
