<UserControl x:Class="RITSU_Desk.Controls.BookingTable"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:RITSU_Desk.Converters"
             xmlns:c="clr-namespace:RITSU_Desk.Controls">
    <UserControl.Resources>
        <conv:BindingProxy x:Key="Proxy" Data="{Binding}" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="420" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DataGrid x:Name="Grid" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                          AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{DynamicResource Border.Default}"
                          CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
                          CanUserResizeRows="False" CanUserSortColumns="False"
                          RowHeight="60" ColumnHeaderHeight="40" BorderThickness="0" Margin="6,6,6,0"
                          Background="Transparent" RowBackground="Transparent"
                          AutomationProperties.Name="Daftar perjalanan">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Waktu" Width="104" MinWidth="104">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="10,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CreatedDateText}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding CreatedTimeText}" Style="{StaticResource Text.Caption}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Rute" Width="*" MinWidth="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="10,0" VerticalAlignment="Center" ToolTip="{Binding RouteText}">
                                        <TextBlock Text="{Binding PickupText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis">
                                            <Run Text="→ " /><Run Text="{Binding DestinationText, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Penumpang" Binding="{Binding CustomerName}" Width="116" MinWidth="116" ElementStyle="{StaticResource Cell.Text}"
                                            Visibility="{Binding Data.ShowCustomerColumn, Source={StaticResource Proxy}, Converter={StaticResource Visible}}" />
                        <DataGridTextColumn Header="Driver" Binding="{Binding DriverName}" Width="116" MinWidth="116" ElementStyle="{StaticResource Cell.Text}"
                                            Visibility="{Binding Data.ShowDriverColumn, Source={StaticResource Proxy}, Converter={StaticResource Visible}}" />
                        <DataGridTemplateColumn Header="Penumpang" Width="124" MinWidth="124"
                                                Visibility="{Binding Data.ShowPartiesColumn, Source={StaticResource Proxy}, Converter={StaticResource Visible}}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="10,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CustomerName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding DriverLine}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Harga" Width="108" MinWidth="108">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="10,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PriceText}" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding DistanceText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding PaymentMethodText, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Status" Width="190" MinWidth="190">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="10,0" VerticalAlignment="Center">
                                        <c:StatusBadge Text="{Binding StageLabel}" Kind="{Binding StageKind}" />
                                        <c:StatusBadge Text="{Binding PaidLabel}" Kind="{Binding PaidKind}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,60"
                            Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}">
                    <TextBlock Text="&#xE804;" Style="{StaticResource Icon}" FontSize="34" Foreground="{DynamicResource Text.Muted}" />
                    <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Text.Sub}" Margin="0,12,0,0"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                    <Button Style="{StaticResource Button.Link}" Content="Hapus semua filter" Margin="0,8,0,0" HorizontalAlignment="Center"
                            Command="{Binding ClearFiltersCommand}"
                            Visibility="{Binding HasActiveFilters, Converter={StaticResource Visible}}" />
                </StackPanel>

                <c:PagerBar Grid.Row="1" DataContext="{Binding Pager}" Margin="16,0,12,12" />
            </Grid>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource Card}" Width="{StaticResource Detail.Width}" Margin="16,0,0,0" Padding="0"
                Visibility="{Binding IsDetailOpen, Converter={StaticResource Visible}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="20,16,12,8">
                    <StackPanel>
                        <TextBlock Text="Detail perjalanan" Style="{StaticResource Text.SectionTitle}" />
                        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,3,0,0">
                            <Run Text="ID #" /><Run Text="{Binding Detail.ShortId, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                    <Button Style="{StaticResource Button.Icon}" Content="&#xE711;" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Command="{Binding CloseDetailCommand}" ToolTip="Tutup detail" AutomationProperties.Name="Tutup detail" />
                </Grid>
                <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="2" Margin="20,0" MinHeight="2"
                             Visibility="{Binding IsDetailLoading, Converter={StaticResource Visible}}" />

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="20,8,20,20">
                    <StackPanel DataContext="{Binding Detail}">
                        <WrapPanel>
                            <c:StatusBadge Text="{Binding StageLabel}" Kind="{Binding StageKind}" Margin="0,0,6,6" />
                            <c:StatusBadge Text="{Binding PaidLabel}" Kind="{Binding PaidKind}" Margin="0,0,6,6" />
                        </WrapPanel>

                        <TextBlock Text="{Binding DataContext.DetailError, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                   Style="{StaticResource Text.Error}"
                                   Visibility="{Binding DataContext.DetailError, RelativeSource={RelativeSource AncestorType=ScrollViewer}, Converter={StaticResource Visible}}" />

                        <Border Style="{StaticResource Panel.Subtle}" Margin="0,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Ellipse Width="10" Height="10" Fill="{DynamicResource Accent.Primary}" VerticalAlignment="Top" Margin="0,4,0,0" HorizontalAlignment="Left" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Titik jemput" Style="{StaticResource Text.Caption}" />
                                    <TextBlock Text="{Binding PickupText}" Style="{StaticResource Text.Value}" FontWeight="SemiBold" Margin="0,2,0,10" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Visibility="{Binding HasStops, Converter={StaticResource Visible}}">
                                    <TextBlock Text="Titik singgah" Style="{StaticResource Text.Caption}" />
                                    <ItemsControl ItemsSource="{Binding StopTexts}" Margin="0,2,0,10">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Style="{StaticResource Text.Value}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <Border Grid.Row="2" Width="10" Height="10" CornerRadius="3" Background="{DynamicResource Brand.Secondary}" VerticalAlignment="Top" Margin="0,4,0,0" HorizontalAlignment="Left" />
                                <StackPanel Grid.Row="2" Grid.Column="1">
                                    <TextBlock Text="Tujuan" Style="{StaticResource Text.Caption}" />
                                    <TextBlock Text="{Binding DestinationText}" Style="{StaticResource Text.Value}" FontWeight="SemiBold" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Text="RINCIAN" Style="{StaticResource Text.Overline}" Margin="0,18,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Harga" Style="{StaticResource Text.Sub}" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PriceText}" Style="{StaticResource Text.Value}" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="1" Text="Jarak" Style="{StaticResource Text.Sub}" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DistanceText}" Style="{StaticResource Text.Value}" />
                            <TextBlock Grid.Row="2" Text="Metode bayar" Style="{StaticResource Text.Sub}" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PaymentMethodText}" Style="{StaticResource Text.Value}" />
                            <TextBlock Grid.Row="3" Text="Penumpang" Style="{StaticResource Text.Sub}" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CustomerName}" Style="{StaticResource Text.Value}" />
                            <TextBlock Grid.Row="4" Text="Driver" Style="{StaticResource Text.Sub}" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding DriverName}" Style="{StaticResource Text.Value}" />
                        </Grid>

                        <TextBlock Text="WAKTU (WIB)" Style="{StaticResource Text.Overline}" Margin="0,18,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Dipesan" Style="{StaticResource Text.Sub}" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CreatedText}" Style="{StaticResource Text.Value}" />
                            <TextBlock Grid.Row="1" Text="Driver siap" Style="{StaticResource Text.Sub}" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DriverReadyText}" Style="{StaticResource Text.Value}" />
                            <TextBlock Grid.Row="2" Text="Mulai jalan" Style="{StaticResource Text.Sub}" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding StartText}" Style="{StaticResource Text.Value}" />
                            <TextBlock Grid.Row="3" Text="Selesai" Style="{StaticResource Text.Sub}" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding EndText}" Style="{StaticResource Text.Value}" />
                            <TextBlock Grid.Row="4" Text="Diperbarui" Style="{StaticResource Text.Sub}" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding UpdatedText}" Style="{StaticResource Text.Value}" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
