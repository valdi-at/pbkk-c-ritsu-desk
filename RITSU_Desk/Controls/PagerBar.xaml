<UserControl x:Class="RITSU_Desk.Controls.PagerBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0,12,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding RangeText}" Style="{StaticResource Text.Sub}" VerticalAlignment="Center" />

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
            <TextBlock Text="Per halaman" Style="{StaticResource Text.Sub}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox ItemsSource="{Binding PageSizeOptions}" SelectedItem="{Binding PageSize}" MinWidth="76"
                      AutomationProperties.Name="Jumlah data per halaman" />
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Style="{StaticResource Button.Icon}" Content="&#xE892;" Command="{Binding FirstCommand}"
                    ToolTip="Halaman pertama" AutomationProperties.Name="Halaman pertama" />
            <Button Style="{StaticResource Button.Icon}" Content="&#xE76B;" Command="{Binding PreviousCommand}"
                    ToolTip="Halaman sebelumnya" AutomationProperties.Name="Halaman sebelumnya" />
            <TextBlock Text="{Binding PageText}" Style="{StaticResource Text.Base}" VerticalAlignment="Center" Margin="10,0" />
            <Button Style="{StaticResource Button.Icon}" Content="&#xE76C;" Command="{Binding NextCommand}"
                    ToolTip="Halaman berikutnya" AutomationProperties.Name="Halaman berikutnya" />
            <Button Style="{StaticResource Button.Icon}" Content="&#xE893;" Command="{Binding LastCommand}"
                    ToolTip="Halaman terakhir" AutomationProperties.Name="Halaman terakhir" />
        </StackPanel>
    </Grid>
</UserControl>
