<UserControl x:Class="RITSU_Desk.Controls.ColumnChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RITSU_Desk.ViewModels"
             x:Name="Root">
    <Grid>
        <Grid x:Name="Plot">
            <Grid Margin="0,20,0,26">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" BorderBrush="{DynamicResource Chart.Grid}" BorderThickness="0,1,0,0" />
                <Border Grid.Row="1" BorderBrush="{DynamicResource Chart.Grid}" BorderThickness="0,1,0,1" />
            </Grid>

            <ItemsControl ItemsSource="{Binding Points, ElementName=Root}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ChartPoint}">
                        <Grid Background="Transparent" ToolTip="{Binding ToolTip}" ToolTipService.InitialShowDelay="150">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="20" />
                                <RowDefinition Height="{Binding RestLength}" />
                                <RowDefinition Height="{Binding FillLength}" />
                                <RowDefinition Height="26" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.RowSpan="2" Text="{Binding ValueText}" FontSize="10.5"
                                       Foreground="{DynamicResource Text.Muted}" FontFamily="{StaticResource Font.Text}"
                                       HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,3"
                                       TextTrimming="CharacterEllipsis" />
                            <Border x:Name="Bar" Grid.Row="2" CornerRadius="5,5,0,0" Margin="5,0"
                                    MaxWidth="38" Background="{DynamicResource Chart.Bar}" />
                            <TextBlock Grid.Row="3" Text="{Binding Label}" FontSize="11"
                                       Foreground="{DynamicResource Text.Secondary}" FontFamily="{StaticResource Font.Text}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </Grid>
                        <DataTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Chart.BarHover}" />
                            </Trigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <StackPanel x:Name="Empty" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
            <TextBlock Text="&#xE9D2;" Style="{StaticResource Icon}" FontSize="28" Foreground="{DynamicResource Text.Muted}" />
            <TextBlock Text="{Binding EmptyText, ElementName=Root}" Style="{StaticResource Text.Caption}" Margin="0,8,0,0"
                       HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
