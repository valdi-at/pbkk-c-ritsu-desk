<UserControl x:Class="RITSU_Desk.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:RITSU_Desk.Controls"
             Loaded="OnLoaded" Unloaded="OnUnloaded">
    <Grid Background="{DynamicResource Login.Background}" ClipToBounds="True">
        <Ellipse Width="460" Height="460" Margin="-170,-170,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                 Fill="{DynamicResource Login.BlobPrimary}" IsHitTestVisible="False">
            <Ellipse.Effect>
                <BlurEffect Radius="140" />
            </Ellipse.Effect>
        </Ellipse>
        <Ellipse Width="460" Height="460" Margin="0,0,-170,-170" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                 Fill="{DynamicResource Login.BlobSecondary}" IsHitTestVisible="False">
            <Ellipse.Effect>
                <BlurEffect Radius="140" />
            </Ellipse.Effect>
        </Ellipse>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Width="400" Margin="24,36" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <c:LogoMark Width="44" Height="44" CornerRadius="16" Effect="{StaticResource Shadow.Logo}" />
                    <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" FontFamily="{StaticResource Font.Display}" FontSize="26"
                               Foreground="{DynamicResource Text.Primary}">
                        <Run Text="RITSU" FontWeight="Bold" /><Run Text=" Desk" FontWeight="Normal" Foreground="{DynamicResource Text.Secondary}" />
                    </TextBlock>
                </StackPanel>
                <TextBlock Text="Kampusmu, rutemu" Style="{StaticResource Text.Caption}" FontSize="13" HorizontalAlignment="Center" Margin="0,8,0,26" />

                <Border Style="{StaticResource Card}" Padding="30,28" Effect="{StaticResource Shadow.Popup}">
                    <StackPanel>
                        <TextBlock Text="Selamat datang kembali" Style="{StaticResource Text.PageTitle}" FontSize="21" />
                        <TextBlock Text="Masuk dengan email dan password akun RITSU Anda." Style="{StaticResource Text.Sub}"
                                   Margin="0,6,0,20" TextWrapping="Wrap" />

                        <Border CornerRadius="14" Padding="12,10" Margin="0,0,0,16" Background="{DynamicResource Soft.Info.Bg}"
                                Visibility="{Binding InfoMessage, Converter={StaticResource Visible}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource Soft.Info.Fg}" VerticalAlignment="Top" Margin="0,2,10,0" />
                                <TextBlock Text="{Binding InfoMessage}" Foreground="{DynamicResource Soft.Info.Fg}" FontFamily="{StaticResource Font.Text}"
                                           TextWrapping="Wrap" MaxWidth="290" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Email" Style="{StaticResource Text.Label}" />
                        <TextBox x:Name="EmailBox" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" MinHeight="40"
                                 VerticalContentAlignment="Center" AutomationProperties.Name="Email" MaxLength="255">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding LoginCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock Text="{Binding EmailError}" Style="{StaticResource Text.Error}"
                                   Visibility="{Binding EmailError, Converter={StaticResource Visible}}" />

                        <TextBlock Text="Password" Style="{StaticResource Text.Label}" Margin="0,16,0,6" />
                        <PasswordBox x:Name="PasswordBox" PasswordChanged="OnPasswordChanged" MinHeight="40"
                                     VerticalContentAlignment="Center" AutomationProperties.Name="Password">
                            <PasswordBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding LoginCommand}" />
                            </PasswordBox.InputBindings>
                        </PasswordBox>
                        <TextBlock Text="{Binding PasswordError}" Style="{StaticResource Text.Error}"
                                   Visibility="{Binding PasswordError, Converter={StaticResource Visible}}" />

                        <Border CornerRadius="14" Padding="12,10" Margin="0,16,0,0" Background="{DynamicResource Soft.Danger.Bg}"
                                Visibility="{Binding ErrorMessage, Converter={StaticResource Visible}}"
                                AutomationProperties.LiveSetting="Assertive">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEA39;" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource Soft.Danger.Fg}" VerticalAlignment="Top" Margin="0,2,10,0" />
                                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Soft.Danger.Fg}" FontFamily="{StaticResource Font.Text}"
                                           TextWrapping="Wrap" MaxWidth="290" />
                            </StackPanel>
                        </Border>

                        <Button Style="{StaticResource Button.Primary}" Command="{Binding LoginCommand}" Margin="0,22,0,0" MinHeight="42"
                                AutomationProperties.Name="Masuk">
                            <StackPanel Orientation="Horizontal">
                                <ProgressBar IsIndeterminate="True" Width="16" Height="16" Margin="0,0,10,0" MinHeight="0"
                                             Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" Foreground="{DynamicResource Text.OnAccent}" />
                                <TextBlock Text="Masuk" FontSize="14" />
                            </StackPanel>
                        </Button>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                            <TextBlock Text="Belum punya akun?" Style="{StaticResource Text.Sub}" VerticalAlignment="Center" />
                            <Button Style="{StaticResource Button.Link}" Content="Daftar di RITSU web" Margin="6,0,0,0"
                                    Command="{Binding OpenSignupCommand}" />
                        </StackPanel>

                        <Border Style="{StaticResource Divider}" Margin="0,22,0,14" />

                        <Grid Visibility="{Binding IsEditingServer, Converter={StaticResource Collapsed}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="StatusDot" Width="9" Height="9" VerticalAlignment="Center" Fill="{DynamicResource Text.Muted}" />
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Style="{StaticResource Text.Base}" FontSize="12.5">
                                    <Run Text="{Binding ServerAddressText, Mode=OneWay}" FontWeight="SemiBold" />
                                </TextBlock>
                                <TextBlock Text="{Binding ServerStatusText}" Style="{StaticResource Text.Caption}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Style="{StaticResource Button.Icon}" Content="&#xE72C;" Command="{Binding RetryServerCommand}"
                                        ToolTip="Periksa ulang server" AutomationProperties.Name="Periksa ulang server" />
                                <Button Style="{StaticResource Button.Link}" Content="Ubah" Margin="4,0,0,0" Command="{Binding EditServerCommand}"
                                        AutomationProperties.Name="Ubah alamat server" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Visibility="{Binding IsEditingServer, Converter={StaticResource Visible}}">
                            <TextBlock Text="Alamat server RITSU" Style="{StaticResource Text.Label}" />
                            <ComboBox IsEditable="True" Text="{Binding ServerInput, UpdateSourceTrigger=PropertyChanged}"
                                      ItemsSource="{Binding KnownServers}" MinHeight="38" AutomationProperties.Name="Alamat server" />
                            <TextBlock Text="{Binding ServerError}" Style="{StaticResource Text.Error}"
                                       Visibility="{Binding ServerError, Converter={StaticResource Visible}}" />
                            <TextBlock Text="Contoh: http://10.10.0.1:3000 atau https://ritsu.shinyshoe.net. HTTP hanya untuk localhost dan jaringan lokal."
                                       Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,6,0,0" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                                <Button Style="{StaticResource Button.Secondary}" Content="Batal" Command="{Binding CancelServerCommand}" Margin="0,0,8,0" />
                                <Button Style="{StaticResource Button.Primary}" Content="Simpan &amp; periksa" Command="{Binding SaveServerCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border HorizontalAlignment="Center" Margin="0,22,0,0" CornerRadius="14" Padding="14,5"
                        Background="{DynamicResource Brand.Secondary}">
                    <TextBlock Text="ITS Campus Transport" FontFamily="{StaticResource Font.Text}" FontSize="13"
                               Foreground="{DynamicResource Brand.SecondaryText}" />
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
