<UserControl x:Class="RITSU_Desk.Views.Student.DriverStatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:RITSU_Desk.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <Grid MaxWidth="760" HorizontalAlignment="Left">
            <Border Style="{StaticResource Card}" Padding="28" VerticalAlignment="Top" Visibility="{Binding HasApplication, Converter={StaticResource Visible}}">
                <StackPanel DataContext="{Binding Application}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="52" Height="52" CornerRadius="14" Background="{DynamicResource Accent.Soft}">
                            <TextBlock Text="&#xE7C3;" Style="{StaticResource Icon}" FontSize="22" Foreground="{DynamicResource Accent.Primary}" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DataContext.StatusHeadline, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       Style="{StaticResource Text.SectionTitle}" FontSize="18" />
                            <c:StatusBadge Text="{Binding StatusLabel}" Kind="{Binding StatusKind}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding DataContext.StatusDescription, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               Style="{StaticResource Text.Body}" Foreground="{DynamicResource Text.Secondary}" Margin="0,18,0,0" />

                    <Border CornerRadius="10" Padding="16,12" Margin="0,18,0,0" Background="{DynamicResource Soft.Danger.Bg}"
                            Visibility="{Binding AdminMessage, Converter={StaticResource Visible}}">
                        <StackPanel>
                            <TextBlock Text="Alasan penolakan dari admin" FontWeight="SemiBold" FontFamily="{StaticResource Font.Text}"
                                       Foreground="{DynamicResource Soft.Danger.Fg}" />
                            <TextBlock Text="{Binding AdminMessage}" Style="{StaticResource Text.Body}" Foreground="{DynamicResource Soft.Danger.Fg}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Divider}" Margin="0,22" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Diajukan" Style="{StaticResource Text.Caption}" />
                            <TextBlock Text="{Binding SubmittedText}" Style="{StaticResource Text.Value}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Ditinjau" Style="{StaticResource Text.Caption}" />
                            <TextBlock Text="{Binding ReviewedText}" Style="{StaticResource Text.Value}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Nomor telepon" Style="{StaticResource Text.Caption}" />
                            <TextBlock Text="{Binding Phone}" Style="{StaticResource Text.Value}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>

                    <Button Style="{StaticResource Button.Secondary}" HorizontalAlignment="Left" Margin="0,24,0,0"
                            Command="{Binding DataContext.OpenWebCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Visibility="{Binding IsDeclined, Converter={StaticResource Visible}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE774;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" />
                            <TextBlock Text="Ajukan lagi di RITSU web" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="32" VerticalAlignment="Top" Visibility="{Binding HasNoApplication, Converter={StaticResource Visible}}">
                <StackPanel>
                    <Border Width="56" Height="56" CornerRadius="16" Background="{DynamicResource Accent.Soft}" HorizontalAlignment="Left">
                        <TextBlock Text="&#xE804;" Style="{StaticResource Icon}" FontSize="24" Foreground="{DynamicResource Accent.Primary}" />
                    </Border>
                    <TextBlock Text="Anda belum pernah mengajukan diri sebagai driver" Style="{StaticResource Text.SectionTitle}" FontSize="18" Margin="0,18,0,0" />
                    <TextBlock Style="{StaticResource Text.Body}" Foreground="{DynamicResource Text.Secondary}" Margin="0,8,0,0"
                               Text="Pengajuan driver membutuhkan nomor telepon dan foto SIM, jadi dilakukan lewat RITSU web. Setelah diajukan, statusnya akan tampil di halaman ini." />
                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,14,0,0" Text="{Binding WebUrlText}" />
                    <Button Style="{StaticResource Button.Primary}" HorizontalAlignment="Left" Margin="0,16,0,0" Command="{Binding OpenWebCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE774;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" />
                            <TextBlock Text="Buka halaman pengajuan" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
