<UserControl x:Class="RITSU_Desk.Views.Student.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:RITSU_Desk.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <Grid MaxWidth="980" HorizontalAlignment="Left">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Margin="0,0,14,14" VerticalAlignment="Top" Padding="24">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="60" Height="60" CornerRadius="30" Background="{DynamicResource Accent.Soft}">
                            <TextBlock Text="{Binding User.Initial}" FontFamily="{StaticResource Font.Display}" FontSize="24" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Accent.Primary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding User.Username}" Style="{StaticResource Text.SectionTitle}" FontSize="18" />
                            <c:StatusBadge Text="{Binding User.RoleLabel}" Kind="{Binding User.RoleKind}" Margin="0,6,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <Border Style="{StaticResource Divider}" Margin="0,20" />

                    <TextBlock Text="Email" Style="{StaticResource Text.Caption}" />
                    <TextBlock Text="{Binding User.Email}" Style="{StaticResource Text.Value}" Margin="0,3,0,14" />
                    <TextBlock Text="Bergabung" Style="{StaticResource Text.Caption}" />
                    <TextBlock Text="{Binding User.JoinedText}" Style="{StaticResource Text.Value}" Margin="0,3,0,14" />
                    <TextBlock Text="Terakhir diperbarui" Style="{StaticResource Text.Caption}" />
                    <TextBlock Text="{Binding User.UpdatedText}" Style="{StaticResource Text.Value}" Margin="0,3,0,14" />
                    <TextBlock Text="Sesi berakhir" Style="{StaticResource Text.Caption}" />
                    <TextBlock Text="{Binding SessionExpiresText}" Style="{StaticResource Text.Value}" Margin="0,3,0,0" />

                    <Border Style="{StaticResource Panel.Subtle}" Margin="0,20,0,0">
                        <TextBlock Style="{StaticResource Text.Body}" Foreground="{DynamicResource Text.Secondary}" FontSize="12.5"
                                   Text="Username, email, dan password diubah lewat RITSU web. Data akademik (NIM, departemen, angkatan) belum tersedia di RITSU." />
                    </Border>
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="1">
                <Border Style="{StaticResource Card}" Margin="0,0,14,14" Padding="24">
                    <StackPanel>
                        <TextBlock Text="Tampilan" Style="{StaticResource Text.SectionTitle}" />
                        <TextBlock Text="Pilihan tema disimpan di perangkat ini." Style="{StaticResource Text.Caption}" Margin="0,3,0,14" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="Terang" IsChecked="{Binding IsLightTheme}" Margin="0,0,28,0" />
                            <RadioButton Content="Gelap" IsChecked="{Binding IsDarkTheme}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,14,14" Padding="24">
                    <StackPanel>
                        <TextBlock Text="Server RITSU" Style="{StaticResource Text.SectionTitle}" />
                        <TextBlock Text="Untuk mengganti server, logout lalu ubah alamatnya di halaman login." Style="{StaticResource Text.Caption}"
                                   Margin="0,3,0,14" TextWrapping="Wrap" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Alamat API" Style="{StaticResource Text.Sub}" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ApiBaseText}" Style="{StaticResource Text.Value}" />
                            <TextBlock Grid.Row="1" Text="Versi API" Style="{StaticResource Text.Sub}" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ApiVersionText}" Style="{StaticResource Text.Value}" />
                            <TextBlock Grid.Row="2" Text="Versi skema" Style="{StaticResource Text.Sub}" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SchemaText}" Style="{StaticResource Text.Value}" />
                            <TextBlock Grid.Row="3" Text="Waktu server" Style="{StaticResource Text.Sub}" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ServerTimeText}" Style="{StaticResource Text.Value}" />
                            <TextBlock Grid.Row="4" Text="Zona waktu DB" Style="{StaticResource Text.Sub}" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding DbTimezoneText}" Style="{StaticResource Text.Value}" />
                            <TextBlock Grid.Row="5" Text="Versi aplikasi" Style="{StaticResource Text.Sub}" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding AppVersionText}" Style="{StaticResource Text.Value}" />
                        </Grid>
                        <TextBlock Text="{Binding MetaError}" Style="{StaticResource Text.Error}" Margin="0,10,0,0"
                                   Visibility="{Binding MetaError, Converter={StaticResource Visible}}" />
                        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,14,0,0" TextWrapping="Wrap"
                                   Text="Statistik harian, mingguan, dan bulanan dihitung server memakai zona waktu database. Waktu di aplikasi ditampilkan dalam WIB." />
                        <TextBlock Text="Log aplikasi" Style="{StaticResource Text.Caption}" Margin="0,14,0,0" />
                        <TextBox Text="{Binding LogPathText, Mode=OneWay}" IsReadOnly="True" Margin="0,4,0,0"
                                 AutomationProperties.Name="Lokasi file log aplikasi" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
