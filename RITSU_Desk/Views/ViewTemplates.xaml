<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:RITSU_Desk.ViewModels"
                    xmlns:svm="clr-namespace:RITSU_Desk.ViewModels.Student"
                    xmlns:avm="clr-namespace:RITSU_Desk.ViewModels.Admin"
                    xmlns:dvm="clr-namespace:RITSU_Desk.ViewModels.Dialogs"
                    xmlns:v="clr-namespace:RITSU_Desk.Views"
                    xmlns:sv="clr-namespace:RITSU_Desk.Views.Student"
                    xmlns:av="clr-namespace:RITSU_Desk.Views.Admin"
                    xmlns:c="clr-namespace:RITSU_Desk.Controls">

    <DataTemplate DataType="{x:Type vm:LoginViewModel}"><v:LoginView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ShellViewModel}"><v:ShellView /></DataTemplate>

    <DataTemplate DataType="{x:Type svm:MyDashboardViewModel}"><sv:MyDashboardView /></DataTemplate>
    <DataTemplate DataType="{x:Type svm:MyBookingsViewModel}"><sv:MyBookingsView /></DataTemplate>
    <DataTemplate DataType="{x:Type svm:DriverStatusViewModel}"><sv:DriverStatusView /></DataTemplate>
    <DataTemplate DataType="{x:Type svm:ProfileViewModel}"><sv:ProfileView /></DataTemplate>

    <DataTemplate DataType="{x:Type avm:AdminDashboardViewModel}"><av:AdminDashboardView /></DataTemplate>
    <DataTemplate DataType="{x:Type avm:UsersViewModel}"><av:UsersView /></DataTemplate>
    <DataTemplate DataType="{x:Type avm:ApplicationsViewModel}"><av:ApplicationsView /></DataTemplate>
    <DataTemplate DataType="{x:Type avm:AdminBookingsViewModel}"><av:AdminBookingsView /></DataTemplate>
    <DataTemplate DataType="{x:Type avm:PaymentMethodsViewModel}"><av:PaymentMethodsView /></DataTemplate>
    <DataTemplate DataType="{x:Type avm:FinanceViewModel}"><av:FinanceView /></DataTemplate>

    <DataTemplate DataType="{x:Type dvm:ConfirmDialogViewModel}">
        <StackPanel Width="440">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.SectionTitle}" FontSize="17" />
            <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Body}" Foreground="{DynamicResource Text.Secondary}" Margin="0,10,0,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button Content="Batal" Style="{StaticResource Button.Secondary}" Command="{Binding CancelCommand}" Margin="0,0,10,0" MinWidth="90"
                        c:FocusOnLoad.Enabled="True" />
                <Button Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" MinWidth="110" x:Name="Confirm"
                        Style="{StaticResource Button.Primary}" />
            </StackPanel>
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsDanger}" Value="True">
                <Setter TargetName="Confirm" Property="Style" Value="{DynamicResource Button.Danger}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate DataType="{x:Type dvm:RejectReasonDialogViewModel}">
        <StackPanel Width="460">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.SectionTitle}" FontSize="17" />
            <TextBlock Style="{StaticResource Text.Body}" Foreground="{DynamicResource Text.Secondary}" Margin="0,8,0,16">
                <Run Text="Alasan ini dikirim ke " /><Run Text="{Binding ApplicantName, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" dan tampil di halaman pengajuan driver di RITSU web." />
            </TextBlock>
            <TextBlock Text="Alasan penolakan" Style="{StaticResource Text.Label}" />
            <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                     MinHeight="96" MaxHeight="180" VerticalScrollBarVisibility="Auto" MaxLength="500"
                     AutomationProperties.Name="Alasan penolakan" c:FocusOnLoad.Enabled="True" />
            <TextBlock Text="{Binding ValidationMessage}" Style="{StaticResource Text.Error}"
                       Visibility="{Binding ValidationMessage, Converter={StaticResource Visible}}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Content="Batal" Style="{StaticResource Button.Secondary}" Command="{Binding CancelCommand}" Margin="0,0,10,0" MinWidth="90" />
                <Button Content="Tolak pengajuan" Style="{StaticResource Button.Danger}" Command="{Binding SubmitCommand}" MinWidth="130" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type dvm:ChangeRoleDialogViewModel}">
        <StackPanel Width="440">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.SectionTitle}" FontSize="17" />
            <TextBlock Style="{StaticResource Text.Body}" Foreground="{DynamicResource Text.Secondary}" Margin="0,8,0,16">
                <Run Text="Role " /><Run Text="{Binding Username, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" saat ini " /><Run Text="{Binding CurrentRoleLabel, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=". Perubahan langsung berlaku di RITSU web." />
            </TextBlock>
            <ListBox ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}" BorderThickness="0" Background="Transparent"
                     AutomationProperties.Name="Pilih role" c:FocusOnLoad.Enabled="True">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Rounded}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" CornerRadius="10" BorderThickness="1" Padding="14,10" Margin="0,0,0,8"
                                            BorderBrush="{DynamicResource Border.Default}" Background="{DynamicResource Surface.Background}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="18" Height="18" VerticalAlignment="Center">
                                                <Ellipse Stroke="{DynamicResource Border.Strong}" StrokeThickness="1.5" />
                                                <Ellipse x:Name="Dot" Width="9" Height="9" Fill="{DynamicResource Accent.Primary}" Visibility="Hidden" />
                                            </Grid>
                                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Base}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface.Hover}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent.Primary}" />
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface.Selected}" />
                                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Batal" Style="{StaticResource Button.Secondary}" Command="{Binding CancelCommand}" Margin="0,0,10,0" MinWidth="90" />
                <Button Content="Simpan role" Style="{StaticResource Button.Primary}" Command="{Binding SaveCommand}" MinWidth="110" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
