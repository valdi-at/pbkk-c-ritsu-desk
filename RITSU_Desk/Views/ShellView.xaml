<UserControl x:Class="RITSU_Desk.Views.ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:RITSU_Desk.Controls">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{DynamicResource Sidebar.Background}" BorderBrush="{DynamicResource Sidebar.Border}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="60" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border BorderBrush="{DynamicResource Border.Default}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" Margin="18,0" VerticalAlignment="Center">
                        <c:LogoMark Width="30" Height="30" CornerRadius="9" IconBrush="{DynamicResource Text.OnAccent}" />
                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontFamily="{StaticResource Font.Display}" FontSize="15"
                                   Foreground="{DynamicResource Text.Primary}">
                            <Run Text="RITSU" FontWeight="Bold" /><Run Text=" Desk" FontWeight="Normal" Foreground="{DynamicResource Text.Secondary}" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <ListBox Grid.Row="1" Style="{StaticResource Nav.List}" ItemContainerStyle="{StaticResource Nav.Item}"
                         ItemsSource="{Binding NavItems}" SelectedItem="{Binding Selected}" Margin="10,4,10,0"
                         AutomationProperties.Name="Menu navigasi" />

                <Border Grid.Row="2" BorderBrush="{DynamicResource Border.Default}" BorderThickness="0,1,0,0" Padding="10,10,10,12">
                    <StackPanel>
                        <Button Style="{StaticResource Button.Sidebar}" Command="{Binding ToggleThemeCommand}" MinHeight="38"
                                AutomationProperties.Name="{Binding ThemeText}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding ThemeGlyph}" Style="{StaticResource Icon}" Width="20" FontSize="15" />
                                <TextBlock Text="{Binding ThemeText}" Margin="12,0,0,0" FontSize="13.5" FontWeight="Medium" />
                            </StackPanel>
                        </Button>

                        <Border Background="{DynamicResource Sidebar.Card}" CornerRadius="14" Padding="10" Margin="0,8,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource Accent.Primary}">
                                    <TextBlock Text="{Binding Initial}" FontFamily="{StaticResource Font.Text}" FontSize="15" FontWeight="Bold"
                                               Foreground="{DynamicResource Text.OnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Username}" FontFamily="{StaticResource Font.Text}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Text.Primary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Email}" />
                                    <TextBlock Text="{Binding RoleLabel}" FontFamily="{StaticResource Font.Text}" FontSize="11.5"
                                               Foreground="{DynamicResource Text.Muted}" />
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource Button.Sidebar}" Width="34" Height="34" MinHeight="0" Padding="0"
                                        HorizontalContentAlignment="Center" Command="{Binding LogoutCommand}"
                                        ToolTip="Logout" AutomationProperties.Name="Logout">
                                    <TextBlock Text="&#xE7E8;" Style="{StaticResource Icon}" FontSize="14" />
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Background="{DynamicResource App.Background}" DataContext="{Binding CurrentPage}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="28,24,28,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.PageTitle}" />
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Sub}" Margin="0,4,0,0" FontSize="13" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding LastLoadedText}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Button Style="{StaticResource Button.Secondary}" Command="{Binding RefreshCommand}" AutomationProperties.Name="Muat ulang"
                            ToolTip="Muat ulang data dari server">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" />
                            <TextBlock Text="Muat ulang" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="2" MinHeight="2" Margin="28,0,28,0"
                         Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" />

            <Border Grid.Row="2" CornerRadius="14" Padding="14,10" Margin="28,10,28,0" Background="{DynamicResource Soft.Danger.Bg}"
                    Visibility="{Binding ShowErrorBanner, Converter={StaticResource Visible}}" AutomationProperties.LiveSetting="Assertive">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding ErrorGlyph}" Style="{StaticResource Icon}" Foreground="{DynamicResource Soft.Danger.Fg}" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="1" Text="{Binding ErrorMessage}" Foreground="{DynamicResource Soft.Danger.Fg}"
                               FontFamily="{StaticResource Font.Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Style="{StaticResource Button.Link}" Content="Coba lagi" Command="{Binding RefreshCommand}" Margin="12,0,0,0" />
                </Grid>
            </Border>

            <ContentControl Grid.Row="3" Content="{Binding}" Focusable="False" Margin="28,16,28,24"
                            Visibility="{Binding ShowContent, Converter={StaticResource Visible}}" />

            <StackPanel Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460" Margin="32"
                        Visibility="{Binding ShowFullError, Converter={StaticResource Visible}}" AutomationProperties.LiveSetting="Assertive">
                <Border Width="64" Height="64" CornerRadius="32" Background="{DynamicResource Soft.Danger.Bg}" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding ErrorGlyph}" Style="{StaticResource Icon}" FontSize="26" Foreground="{DynamicResource Soft.Danger.Fg}" />
                </Border>
                <TextBlock Text="Data belum bisa dimuat" Style="{StaticResource Text.SectionTitle}" HorizontalAlignment="Center" Margin="0,16,0,6" />
                <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Body}" Foreground="{DynamicResource Text.Secondary}"
                           TextAlignment="Center" />
                <Button Style="{StaticResource Button.Primary}" Command="{Binding RefreshCommand}" HorizontalAlignment="Center" Margin="0,18,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="Coba lagi" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
