<UserControl x:Class="RITSU_Desk.Views.Admin.AdminDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:RITSU_Desk.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel>
            <Border CornerRadius="10" Padding="16,12" Margin="0,0,14,16" Background="{DynamicResource Soft.Warning.Bg}"
                    Visibility="{Binding HasPendingApplications, Converter={StaticResource Visible}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="{DynamicResource Soft.Warning.Fg}" Margin="0,0,12,0" />
                    <TextBlock Grid.Column="1" Text="{Binding PendingApplicationsText}" Foreground="{DynamicResource Soft.Warning.Fg}"
                               FontFamily="{StaticResource Font.Text}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Style="{StaticResource Button.Link}" Content="Tinjau sekarang" Command="{Binding OpenApplicationsCommand}" />
                </Grid>
            </Border>

            <ItemsControl ItemsSource="{Binding Cards}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <c:StatCard Title="{Binding Title}" Value="{Binding Value}" Caption="{Binding Caption}" Kind="{Binding Kind}" Margin="0,0,14,14" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Margin="0,0,14,14">
                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Pendapatan harian (Rp)" Style="{StaticResource Text.SectionTitle}" />
                                <TextBlock Text="Pemesanan lunas per tanggal selesai, 30 hari terakhir (maks. 14 hari)" Style="{StaticResource Text.Caption}" Margin="0,3,0,14" />
                            </StackPanel>
                            <Button Style="{StaticResource Button.Link}" Content="Laporan keuangan" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Command="{Binding OpenFinanceCommand}" />
                        </Grid>
                        <c:ColumnChart Points="{Binding DailyRevenue}" Height="250" EmptyText="Belum ada pendapatan dalam 30 hari terakhir." />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,14,14">
                    <StackPanel>
                        <TextBlock Text="Pendapatan per metode pembayaran" Style="{StaticResource Text.SectionTitle}" />
                        <TextBlock Text="Semua pemesanan lunas" Style="{StaticResource Text.Caption}" Margin="0,3,0,18" />
                        <c:BarList Points="{Binding MethodRevenue}" EmptyText="Belum ada metode pembayaran." />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Margin="0,0,14,14">
                    <StackPanel>
                        <TextBlock Text="Top driver" Style="{StaticResource Text.SectionTitle}" />
                        <TextBlock Text="Pendapatan terbesar dari pemesanan lunas" Style="{StaticResource Text.Caption}" Margin="0,3,0,10" />
                        <ItemsControl ItemsSource="{Binding TopDrivers}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource Border.Default}">
                                            <TextBlock Text="{Binding Rank}" FontSize="12" FontWeight="Bold" FontFamily="{StaticResource Font.Text}"
                                                       Foreground="{DynamicResource Text.Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Username}" Style="{StaticResource Text.Base}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding TripsText}" Style="{StaticResource Text.Caption}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding EarnedText}" Style="{StaticResource Text.Base}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Soft.Success.Fg}" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Belum ada driver dengan pemesanan lunas." Style="{StaticResource Text.Caption}" Margin="0,16"
                                   HorizontalAlignment="Center" Visibility="{Binding HasTopDrivers, Converter={StaticResource Collapsed}}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,14,14">
                    <StackPanel>
                        <TextBlock Text="Aktivitas terbaru" Style="{StaticResource Text.SectionTitle}" />
                        <TextBlock Text="Dari waktu pembuatan dan perubahan data di RITSU" Style="{StaticResource Text.Caption}" Margin="0,3,0,10" />
                        <ItemsControl ItemsSource="{Binding Activity}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <c:IconChip Glyph="{Binding Glyph}" Kind="{Binding Kind}" />
                                        <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource Text.Base}" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" · " Foreground="{DynamicResource Text.Muted}" /><Run Text="{Binding Actor, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding AtText}" Style="{StaticResource Text.Caption}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding WhenText}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding ActivityError}" Style="{StaticResource Text.Error}"
                                   Visibility="{Binding ActivityError, Converter={StaticResource Visible}}" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
