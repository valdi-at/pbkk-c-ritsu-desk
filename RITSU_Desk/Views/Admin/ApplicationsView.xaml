<UserControl x:Class="RITSU_Desk.Views.Admin.ApplicationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:RITSU_Desk.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus}" DisplayMemberPath="Label"
                      Width="190" AutomationProperties.Name="Filter status pengajuan" />
            <TextBlock Text="Pengajuan menunggu selalu tampil paling atas, sama seperti di web." Style="{StaticResource Text.Caption}"
                       VerticalAlignment="Center" Margin="14,0,0,0" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="420" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{DynamicResource Border.Default}"
                              CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
                              CanUserResizeRows="False" CanUserSortColumns="False"
                              RowHeight="56" ColumnHeaderHeight="40" BorderThickness="0" Margin="6,6,6,0"
                              Background="Transparent" RowBackground="Transparent"
                              AutomationProperties.Name="Daftar pengajuan driver">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Pemohon" Width="*" MinWidth="200">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="10,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Username}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Email}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Telepon" Binding="{Binding Phone}" Width="140" MinWidth="140" ElementStyle="{StaticResource Cell.Text}" />
                            <DataGridTextColumn Header="Diajukan" Binding="{Binding SubmittedText}" Width="170" MinWidth="170" ElementStyle="{StaticResource Cell.Text}" />
                            <DataGridTemplateColumn Header="Status" Width="120" MinWidth="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <c:StatusBadge Text="{Binding StatusLabel}" Kind="{Binding StatusKind}" Margin="10,0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,60"
                                Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}">
                        <TextBlock Text="&#xE8A5;" Style="{StaticResource Icon}" FontSize="34" Foreground="{DynamicResource Text.Muted}" />
                        <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Text.Sub}" Margin="0,12,0,0" HorizontalAlignment="Center" />
                    </StackPanel>

                    <c:PagerBar Grid.Row="1" DataContext="{Binding Pager}" Margin="16,0,12,12" />
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" Width="{StaticResource Detail.Width}" Margin="16,0,0,0" Padding="0"
                    Visibility="{Binding IsDetailOpen, Converter={StaticResource Visible}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="20,16,12,8">
                        <TextBlock Text="Detail pengajuan" Style="{StaticResource Text.SectionTitle}" VerticalAlignment="Center" />
                        <Button Style="{StaticResource Button.Icon}" Content="&#xE711;" HorizontalAlignment="Right"
                                Command="{Binding CloseDetailCommand}" ToolTip="Tutup detail" AutomationProperties.Name="Tutup detail" />
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,4,20,12">
                        <StackPanel>
                            <Border CornerRadius="10" Height="210" Background="{DynamicResource Surface.Subtle}"
                                    BorderBrush="{DynamicResource Border.Default}" BorderThickness="1" ClipToBounds="True">
                                <Grid>
                                    <Button x:Name="LicenseButton" Click="OnLicenseClick" Cursor="Hand" Background="Transparent" BorderThickness="0" Padding="0"
                                            ToolTip="Klik untuk memperbesar" AutomationProperties.Name="Foto SIM, klik untuk memperbesar"
                                            Visibility="{Binding LicenseImage, Converter={StaticResource Visible}}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <ContentPresenter />
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Image Source="{Binding LicenseImage}" Stretch="Uniform" Margin="6" RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Button>
                                    <ProgressBar IsIndeterminate="True" Width="120" Height="3" MinHeight="3"
                                                 Visibility="{Binding IsLicenseLoading, Converter={StaticResource Visible}}" />
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                                Visibility="{Binding LicenseError, Converter={StaticResource Visible}}">
                                        <TextBlock Text="&#xEB9F;" Style="{StaticResource Icon}" FontSize="30" Foreground="{DynamicResource Text.Muted}" />
                                        <TextBlock Text="{Binding LicenseError}" Style="{StaticResource Text.Caption}" Margin="0,8,0,0" HorizontalAlignment="Center" />
                                        <Button Style="{StaticResource Button.Link}" Content="Coba lagi" HorizontalAlignment="Center" Margin="0,4,0,0"
                                                Command="{Binding ReloadLicenseCommand}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <TextBlock Text="Foto SIM" Style="{StaticResource Text.Caption}" Margin="0,6,0,0" HorizontalAlignment="Center" />

                            <StackPanel DataContext="{Binding SelectedItem}" Margin="0,14,0,0">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Username}" Style="{StaticResource Text.SectionTitle}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Email}" Style="{StaticResource Text.Sub}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <c:StatusBadge Text="{Binding StatusLabel}" Kind="{Binding StatusKind}" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                </Grid>
                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Telepon" Style="{StaticResource Text.Sub}" Margin="0,0,0,8" />
                                    <TextBlock Grid.Column="1" Text="{Binding Phone}" Style="{StaticResource Text.Value}" />
                                    <TextBlock Grid.Row="1" Text="Diajukan" Style="{StaticResource Text.Sub}" Margin="0,0,0,8" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SubmittedText}" Style="{StaticResource Text.Value}" />
                                    <TextBlock Grid.Row="2" Text="Ditinjau" Style="{StaticResource Text.Sub}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ReviewedText}" Style="{StaticResource Text.Value}" />
                                </Grid>
                                <Border CornerRadius="8" Padding="12,10" Margin="0,14,0,0" Background="{DynamicResource Soft.Danger.Bg}"
                                        Visibility="{Binding AdminMessage, Converter={StaticResource Visible}}">
                                    <StackPanel>
                                        <TextBlock Text="Alasan penolakan" FontWeight="SemiBold" FontFamily="{StaticResource Font.Text}" Foreground="{DynamicResource Soft.Danger.Fg}" />
                                        <TextBlock Text="{Binding AdminMessage}" Style="{StaticResource Text.Body}" Foreground="{DynamicResource Soft.Danger.Fg}" FontSize="12.5" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" BorderBrush="{DynamicResource Border.Default}" BorderThickness="0,1,0,0" Padding="20,14"
                            Visibility="{Binding SelectedItem.IsPending, Converter={StaticResource Visible}, FallbackValue=Collapsed}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource Button.DangerOutline}" Command="{Binding RejectCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" />
                                    <TextBlock Text="Tolak" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Style="{StaticResource Button.Primary}" Command="{Binding ApproveCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8FB;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" />
                                    <TextBlock Text="Setujui" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
