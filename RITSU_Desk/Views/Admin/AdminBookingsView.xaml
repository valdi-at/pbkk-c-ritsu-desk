<UserControl x:Class="RITSU_Desk.Views.Admin.AdminBookingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:RITSU_Desk.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <c:BookingFilterBar Placeholder="Cari lokasi, penumpang, atau driver...">
                <c:BookingFilterBar.Extra>
                    <ComboBox Width="160" ItemsSource="{Binding PaymentMethodOptions}" SelectedItem="{Binding SelectedPaymentMethod}"
                              DisplayMemberPath="Label" AutomationProperties.Name="Filter metode pembayaran" />
                </c:BookingFilterBar.Extra>
            </c:BookingFilterBar>
            <Button Grid.Column="1" Style="{StaticResource Button.Secondary}" Command="{Binding ExportCommand}" VerticalAlignment="Top"
                    Margin="10,0,0,0" MinHeight="34" ToolTip="Ekspor semua pemesanan yang cocok dengan filter ke CSV">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" />
                    <TextBlock Text="Ekspor CSV" />
                </StackPanel>
            </Button>
        </Grid>
        <c:BookingTable Grid.Row="1" Margin="0,6,0,0" />
    </Grid>
</UserControl>
