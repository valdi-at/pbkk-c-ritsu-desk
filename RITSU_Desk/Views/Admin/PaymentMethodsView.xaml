<UserControl x:Class="RITSU_Desk.Views.Admin.PaymentMethodsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:RITSU_Desk.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border CornerRadius="10" Padding="14,10" Margin="0,0,0,16" Background="{DynamicResource Soft.Info.Bg}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource Soft.Info.Fg}" Margin="0,0,10,0" />
                <TextBlock Foreground="{DynamicResource Soft.Info.Fg}" FontFamily="{StaticResource Font.Text}" TextWrapping="Wrap" VerticalAlignment="Center"
                           Text="Halaman ini hanya baca. Menambah, mengubah, dan menghapus metode pembayaran butuh endpoint tulis (B5) yang belum aktif di server RITSU." />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" VerticalAlignment="Top">
            <StackPanel>
                <Grid Margin="20,16,20,4">
                    <TextBlock Style="{StaticResource Text.Sub}" VerticalAlignment="Center">
                        <Run Text="{Binding CountText, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" metode · " /><Run Text="{Binding TotalBookingsText, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" pemesanan tercatat" />
                    </TextBlock>
                </Grid>
                <DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{DynamicResource Border.Default}"
                          CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" CanUserResizeRows="False"
                          RowHeight="48" ColumnHeaderHeight="40" BorderThickness="0" Margin="6,0,6,8"
                          Background="Transparent" RowBackground="Transparent" AutomationProperties.Name="Daftar metode pembayaran">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nama" Binding="{Binding Name}" Width="200" MinWidth="200" ElementStyle="{StaticResource Cell.Strong}" />
                        <DataGridTemplateColumn Header="Jenis" Width="130" MinWidth="130" SortMemberPath="TypeLabel">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <c:StatusBadge Text="{Binding TypeLabel}" Kind="{Binding TypeKind}" Margin="10,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Jumlah transaksi" Binding="{Binding BookingCountText}" Width="150" MinWidth="150" ElementStyle="{StaticResource Cell.Number}"
                                            SortMemberPath="Dto.BookingCount" />
                        <DataGridTextColumn Header="Info pembayaran" Binding="{Binding PaymentInfoText}" Width="*" MinWidth="160" ElementStyle="{StaticResource Cell.Text}" />
                        <DataGridTextColumn Header="Ditambahkan" Binding="{Binding CreatedText}" Width="140" MinWidth="140" ElementStyle="{StaticResource Cell.Text}"
                                            SortMemberPath="Dto.CreatedAt" />
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="Belum ada metode pembayaran." Style="{StaticResource Text.Sub}" HorizontalAlignment="Center" Margin="0,30"
                           Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
