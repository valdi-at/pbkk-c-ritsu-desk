<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:conv="clr-namespace:RITSU_Desk.Converters">

    <FontFamily x:Key="Font.Text">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Display">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <CornerRadius x:Key="Radius.Card">20</CornerRadius>
    <CornerRadius x:Key="Radius.Control">14</CornerRadius>
    <CornerRadius x:Key="Radius.Chip">16</CornerRadius>
    <Thickness x:Key="Padding.Card">20</Thickness>
    <sys:Double x:Key="Detail.Width">320</sys:Double>

    <conv:IsVisibleConverter x:Key="Visible" />
    <conv:IsVisibleConverter x:Key="Collapsed" Invert="True" />
    <conv:UpperCaseConverter x:Key="Upper" />

    <DropShadowEffect x:Key="Shadow.Card" BlurRadius="12" ShadowDepth="1.5" Direction="270" Opacity="0.08" Color="#0C2A2A" />
    <DropShadowEffect x:Key="Shadow.Popup" BlurRadius="40" ShadowDepth="10" Direction="270" Opacity="0.16" Color="#0C2A2A" />
    <DropShadowEffect x:Key="Shadow.Logo" BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.35" Color="#00C5C7" />

    <Style x:Key="FocusVisual.Rounded">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" RadiusX="16" RadiusY="16" SnapsToDevicePixels="True"
                               Stroke="{DynamicResource Focus.Ring}" StrokeThickness="2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Text.Base" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Text}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style x:Key="Text.PageTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style x:Key="Text.SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Text.Body" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="20" />
    </Style>

    <Style x:Key="Text.Sub" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
        <Setter Property="FontSize" Value="12.5" />
    </Style>

    <Style x:Key="Text.Caption" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="Foreground" Value="{DynamicResource Text.Muted}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="Text.Label" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style x:Key="Text.Overline" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="Foreground" Value="{DynamicResource Text.Muted}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <Style x:Key="Text.Value" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Text.Error" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="Foreground" Value="{DynamicResource Soft.Danger.Fg}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>

    <Style x:Key="Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Icons}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Surface.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Card.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Effect" Value="{StaticResource Shadow.Card}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
        <Setter Property="Padding" Value="{StaticResource Padding.Card}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Panel.Subtle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Surface.Subtle}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Chip}" />
        <Setter Property="Padding" Value="14,12" />
    </Style>

    <Style x:Key="Divider" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource Border.Default}" />
        <Setter Property="Margin" Value="0,14" />
    </Style>

    <Style x:Key="Button.Base" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource Font.Text}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Rounded}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.Control}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="Button.Primary" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Accent.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Accent.Primary}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.OnAccent}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Accent.PrimaryHover}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Accent.PrimaryHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Accent.PrimaryPressed}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Accent.PrimaryPressed}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Button.Secondary" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Secondary.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Strong}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Secondary.Hover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Secondary.Pressed}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Button.Danger" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Danger.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Danger.Primary}" />
        <Setter Property="Foreground" Value="{DynamicResource Danger.OnSolid}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Danger.Hover}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Danger.Hover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Danger.Pressed}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Danger.Pressed}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Button.DangerOutline" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Secondary.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Danger.Primary}" />
        <Setter Property="Foreground" Value="{DynamicResource Soft.Danger.Fg}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Soft.Danger.Bg}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Button.Ghost" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
        <Setter Property="Padding" Value="10,0" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Surface.Hover}" />
                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Button.Icon" TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Icons}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="Button.Link" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Text.Link}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Text}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Rounded}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter x:Name="Cp" VerticalAlignment="Center" RecognizesAccessKey="True">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextDecorations" Value="Underline" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Accent.Text}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Cp" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Button.Sidebar" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Sidebar.Text}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Padding" Value="12,0" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Sidebar.ItemHover}" />
                <Setter Property="Foreground" Value="{DynamicResource Sidebar.TextHover}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Nav.List" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Cycle" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Nav.Item" TargetType="ListBoxItem">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Rounded}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <StackPanel>
                        <TextBlock Text="{Binding Section}"
                                   Visibility="{Binding HasSection, Converter={StaticResource Visible}}"
                                   Margin="12,16,0,6" FontSize="10.5" FontWeight="SemiBold"
                                   FontFamily="{StaticResource Font.Text}"
                                   Foreground="{DynamicResource Sidebar.Section}" />
                        <Border x:Name="Bd" CornerRadius="12" Background="Transparent" Height="38" Margin="0,1">
                            <StackPanel Orientation="Horizontal" Margin="12,0,10,0" VerticalAlignment="Center">
                                <TextBlock x:Name="Glyph" Text="{Binding Glyph}" Style="{StaticResource Icon}"
                                           Width="20" FontSize="15" Foreground="{DynamicResource Sidebar.Text}" />
                                <TextBlock x:Name="Label" Text="{Binding Title}" Margin="12,0,0,0" VerticalAlignment="Center"
                                           FontFamily="{StaticResource Font.Text}" FontSize="13.5" FontWeight="Medium"
                                           Foreground="{DynamicResource Sidebar.Text}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Sidebar.ItemHover}" />
                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Sidebar.TextHover}" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Sidebar.TextHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Sidebar.ItemActive}" />
                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Sidebar.TextActive}" />
                            <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Sidebar.TextActive}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Cell.Text" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="10,0" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        <Setter Property="ToolTipService.InitialShowDelay" Value="700" />
    </Style>

    <Style x:Key="Cell.Number" TargetType="TextBlock" BasedOn="{StaticResource Cell.Text}">
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <Style x:Key="Cell.Strong" TargetType="TextBlock" BasedOn="{StaticResource Cell.Text}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Placeholder" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Text.Muted}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Text}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
